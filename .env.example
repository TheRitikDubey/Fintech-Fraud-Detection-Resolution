# ─── Sentinel Support — environment template ───────────────────────────────
# Copy to api/.env (and adjust) for local dev. Never commit real secrets.

# API server
PORT=8000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# Redis (idempotency store + rate-limit token bucket) — used from Step 2 onward
REDIS_URL="redis://localhost:6379"

# Action endpoints auth (X-API-Key header) — used from Step 6 onward
API_KEY="dev-local-key-change-me"

# Scoring — used from Step 3 onward
SCORE_THRESHOLD=70        # alerts created when score >= threshold (0–100)
HISTORY_DAYS=90           # days of prior history fed to the rank-order algo

# Rate limiting — used from Step 8 onward
RATE_LIMIT_RPS=5          # requests per second per client (token bucket)
