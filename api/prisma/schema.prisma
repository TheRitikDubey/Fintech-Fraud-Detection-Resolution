// Sentinel Support — core schema.
// Ingestion → scoring → alerts → triage → audit. See README architecture section.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
}

enum CardStatus {
  ACTIVE
  FROZEN
  PENDING_OTP
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  TRIAGED
  RESOLVED
  FALSE_POSITIVE
}

enum CaseStatus {
  OPEN
  RESOLVED
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  createdAt    DateTime      @default(now())

  accounts     Account[]
  cards        Card[]
  transactions Transaction[]
  alerts       Alert[]
  cases        Case[]

  @@map("customers")
}

model Account {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       AccountType @default(CHECKING)
  currency   String      @default("USD")
  createdAt  DateTime    @default(now())

  cards      Card[]

  @@index([customerId])
  @@map("accounts")
}

model Card {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id])
  last4      String
  network    String     @default("VISA")
  status     CardStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())

  @@index([customerId])
  @@map("cards")
}

model Transaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  txnId       String // external id from ingest payload

  amountCents BigInt // integer cents (money as integers)
  currency    String

  mcc         String   @default("") // Merchant Category Code
  merchant    String   @default("")
  country     String   @default("")
  city        String   @default("")

  status      String   @default("SUCCESS") // payload-driven lifecycle

  ts          DateTime // event time: when the transaction occurred (from payload)
  createdAt   DateTime @default(now()) // row time: when we ingested it
  updatedAt   DateTime @updatedAt

  alert       Alert?

  @@unique([customerId, txnId]) // dedupe key for upsert
  @@index([customerId, ts(sort: Desc)]) // critical: time-range queries
  @@index([customerId, merchant]) // critical: merchant frequency lookups
  @@index([mcc]) // MCC rarity
  @@map("transactions")
}

model Alert {
  id            String        @id @default(cuid())
  transactionId String        @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  customerId    String // denormalized for queue filtering
  customer      Customer      @relation(fields: [customerId], references: [id])

  score         Int
  severity      AlertSeverity
  status        AlertStatus   @default(OPEN)
  reasons       Json // [{ code, detail, weight }]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  case          Case?

  @@index([status, createdAt(sort: Desc)]) // queue filter + keyset pagination
  @@index([customerId])
  @@map("alerts")
}

model Case {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  alertId    String?     @unique // triage container, one per alert
  alert      Alert?      @relation(fields: [alertId], references: [id])
  kind       String      @default("TRIAGE") // TRIAGE | DISPUTE | FREEZE
  status     CaseStatus  @default(OPEN)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  events     CaseEvent[]

  @@index([customerId])
  @@map("cases")
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  actor     String
  action    String
  payload   Json // redacted payload snapshot
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@map("case_events")
}
